name = "warheatmap"
main = "workers/warheatmap-worker.js"
compatibility_date = "2024-01-01"

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "warheatmap-db"
database_id = "YOUR_D1_DATABASE_ID"

# KV Namespace bindings
[[kv_namespaces]]
binding = "ANALYTICS_KV"
id = "YOUR_KV_NAMESPACE_ID"

[[kv_namespaces]]
binding = "STRAIT_NEWS_KV"
id = "YOUR_STRAIT_KV_NAMESPACE_ID"

# R2 Bucket
[[r2_buckets]]
binding = "ASSETS"
bucket_name = "warheatmap-assets"

# Secrets (set via: wrangler secret put BSKY_APP_PASSWORD)
# BSKY_APP_PASSWORD — Bluesky app password for AT Protocol posting

# Routes
[[routes]]
pattern = "warheatmap.app/*"
zone_name = "warheatmap.app"
